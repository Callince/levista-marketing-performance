# Copy this file to .env and put your own password in it. Never commit .env.
#
# Confirmed on this machine:
#   postgresql-x64-17  ->  port 5432   (recommended)
#   postgresql-x64-16  ->  port 5433
#   postgresql-x64-13  ->  port 5434
# All three require a password (scram-sha-256), so there is no passwordless option.
#
# The database itself does not need to exist yet — `python setup_postgres.py`
# creates it and applies the schema.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/levista

# Where the raw platform exports live
INPUT_DIR=D:\levista\Levista performance report input files from the respected applications

# Where Levista_Performance_Report.xlsx / .pptx get written
OUTPUT_DIR=D:\levista\output
